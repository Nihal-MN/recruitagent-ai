# Copy to .env and adjust as needed. Everything works with defaults.

# Host ports (change if they clash with something else on your machine)
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432

# AI provider for the agent loop:
#   auto (default) → OpenAI when OPENAI_API_KEY is set, deterministic demo agent otherwise
#   mock           → always the deterministic demo agent
#   openai         → require OpenAI (fails loudly if the key is missing)
AI_PROVIDER=auto

# Optional — enables live tool calling. Never commit a real key.
OPENAI_API_KEY=
# Optional — pin a model (defaults to a sensible current model)
OPENAI_MODEL=
